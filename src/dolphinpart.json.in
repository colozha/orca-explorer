{
    "KParts": {
        "Capabilities": [
            "ReadOnly",
            "BrowserView"
        ]
    },
    "KPlugin": {
        "Icon": "view-list-icons",
        "InitialPreference": 7,
        "License": "LGPL v2+",
        "MimeTypes": [
            "inode/directory"
        ],
        "Name": "Orca Explorer View",
        "Version": "@PROJECT_VERSION@"
    },
    "MimeType": "inode/directory;",
    "X-KDE-BrowserView-Built-Into": "konqueror",
    "X-KDE-BrowserView-HideFromMenus": true,
    "X-Konqueror-Actions-File": "@KDE_INSTALL_FULL_DATADIR@/orca-explorer/dolphinpartactions.desktop"
}
