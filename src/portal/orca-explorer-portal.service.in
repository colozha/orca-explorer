[Unit]
Description=Orca Explorer file chooser portal
PartOf=graphical-session.target
After=graphical-session.target
[Service]
Type=dbus
BusName=org.freedesktop.impl.portal.desktop.orca
ExecStart=@ORCA_LAUNCHER_BINDIR@/orca-explorer-portal
Slice=background.slice
